{
  "manifest_version": 3,
  "name": "ProspectLens",
  "version": "1.0.0",
  "description": "Automated B2B lead collection from IndiaMART, Google Maps, and Justdial",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://www.indiamart.com/*",
    "https://dir.indiamart.com/*",
    "https://www.google.com/maps/*",
    "https://maps.google.com/*",
    "https://www.justdial.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ProspectLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.indiamart.com/*",
        "https://dir.indiamart.com/*",
        "https://www.google.com/maps/*",
        "https://maps.google.com/*",
        "https://www.justdial.com/*"
      ],
      "js": [
        "src/content-scripts/utils/logger.js",
        "src/content-scripts/utils/regex.js",
        "src/content-scripts/utils/domHelpers.js",
        "src/content-scripts/utils/validator.js",
        "src/content-scripts/utils/normalizer.js",
        "src/content-scripts/adapters/baseAdapter.js",
        "src/content-scripts/adapters/googleMaps.js",
        "src/content-scripts/adapters/indiaMart.js",
        "src/content-scripts/adapters/justdial.js",
        "src/content-scripts/adapters/tradeIndia.js",
        "src/content-scripts/engine/stateManager.js",
        "src/content-scripts/engine/progressManager.js",
        "src/content-scripts/engine/queueManager.js",
        "src/content-scripts/engine/scrollManager.js",
        "src/content-scripts/engine/extractionPipeline.js",
        "src/content-scripts/messaging.js",
        "src/content-scripts/collector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}